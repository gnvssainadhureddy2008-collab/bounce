{
  "name": "Lapse",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string"
    },
    "end_date": {
      "type": "string"
    },
    "barrier": {
      "type": "string"
    },
    "recovery_days": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "recovered"
      ],
      "default": "open"
    },
    "risk_score": {
      "type": "number"
    },
    "adaptation": {
      "type": "string"
    }
  },
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}